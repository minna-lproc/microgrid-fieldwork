            "DK"
          ],
          "help": "",
          "details": true
        },
        {
          "id": "I3",
          "label": "Has the community had earlier energy projects (solar, hydro, diesel, mini-grid)? How did they perform and why did they stop, if they did?",
          "type": "text",
          "options": [],
          "help": "Record: ____________"
        }
      ]
    },
    {
      "id": "J",
      "title": "Critical facilities",
      "instrument": "community",
      "questions": [
        {
          "id": "J_facilities",
          "label": "Community facility inventory",
          "type": "table",
          "rows": [
            "Barangay hall",
            "Elementary / high school",
            "Health station / clinic",
            "Water system / pumping",
            "Evacuation center",
            "Church / mosque / chapel",
            "Market / cold storage",
            "Communications tower / radio",
            "Fish landing / port",
            "Street or public lighting",
