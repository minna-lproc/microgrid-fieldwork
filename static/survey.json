            "Monthly consumption",
            "Safety reminders",
            "How to complain",
            "How the operator uses the money collected"
          ],
          "help": ""
        },
        {
          "id": "G5",
          "label": "Are you worried about any of these? (select all)",
          "type": "multi",
          "options": [
            "Being disconnected if unable to pay",
            "Prices rising later",
            "Meter accuracy",
            "Safety of wiring or equipment",
            "Data privacy of usage records",
            "Service ending when the operator leaves",
            "None"
          ],
          "help": ""
        }
      ]
    },
    {
      "id": "H",
      "title": "Awareness & participation",
      "instrument": "household",
      "questions": [
