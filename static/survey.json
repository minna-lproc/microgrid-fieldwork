{
  "title": "Community Energy Needs and Microgrid Design Survey",
  "version": "2026-pilot-1",
  "consent": "Good day. We are from the University of the Immaculate Conception. We are studying how electricity is used in your community to help plan a possible microgrid. Taking part is voluntary. You may skip any question or stop at any time, and this will not affect any service or benefit you receive. Your answers will be used only for planning and research, reported in groups, and kept confidential in line with the Data Privacy Act of 2012 (R.A. 10173). No decision has been made about building a microgrid in your community. Do you agree to be interviewed?",
  "sections": [
    {
      "id": "A",
      "title": "Respondent & household",
      "instrument": "household",
      "questions": [
        {
          "id": "A1",
          "label": "Sex",
          "type": "select",
          "options": [
            "Female",
            "Male",
            "Prefer not to say"
          ],
          "help": ""
        },
        {
          "id": "A2",
          "label": "Age",
          "type": "select",
          "options": [
            "18–24",
            "25–34",
            "35–49",
            "50–64",
            "65 and above"
          ],
          "help": ""
        },
        {
          "id": "A3",
          "label": "Number of household members living here for most of the year: ______ ;",
          "type": "fields",
          "options": [],
          "help": "Leave unknown values blank. Zero means none.",
          "fields": [
            {
              "id": "members",
              "label": "Total household members",
              "type": "number"
            },
            {
              "id": "under5",
              "label": "Under 5 years",
              "type": "number"
            },
            {
              "id": "over60",
              "label": "60 years and above",
              "type": "number"
            },
            {
              "id": "equipment",
              "label": "Members with disability or needing electrical equipment",
              "type": "number"
            }
          ]
        },
        {
          "id": "A4",
          "label": "Main source of household income (select main one)",
          "type": "select",
          "options": [
            "Farming",
            "Fishing",
            "Small business / trading",
            "Wage work",
            "Remittances",
            "Government assistance",
            "Other:"
          ],
          "help": "",
          "details": true
        },
        {
          "id": "A5",
          "label": "Approximate total household cash income per month",
          "type": "select",
          "options": [
            "Below ₱2,000",
            "₱2,000–₱5,999",
            "₱6,000–₱9,999",
            "₱10,000–₱19,999",
            "₱20,000 and above",
            "RTA"
          ],
          "help": "Optional. Use only ranges; do not ask for exact figures."
        },
        {
          "id": "A6",
          "label": "Is your household a beneficiary of 4Ps or listed in the barangay poverty list?",
          "type": "select",
          "options": [
            "Yes",
            "No",
            "DK"
          ],
          "help": ""
        },
        {
          "id": "A7",
          "label": "Does the household belong to an Indigenous Cultural Community / Indigenous People (ICC/IP)?",
          "type": "select",
          "options": [
            "Yes:",
            "No",
            "RTA"
          ],
          "help": "Enumerator: if yes, flag the community for free, prior and informed consent (FPIC) processes with the NCIP.",
          "details": true
        },
        {
          "id": "A8",
          "label": "Do you own or rent the dwelling and the land it stands on?",
          "type": "select",
          "options": [
            "Own house and lot",
            "Own house, land is owned by another / public",
            "Rent",
            "Other:"
          ],
          "help": "",
          "details": true
        },
        {
          "id": "A9",
          "label": "How long has your household lived here?",
          "type": "select",
          "options": [
            "Less than 2 years",
            "2–5 years",
            "6–10 years",
            "More than 10 years"
          ],
          "help": ""
        },
        {
          "id": "A10",
          "label": "Do you expect the household to still live here in 10 years?",
          "type": "select",
          "options": [
            "Yes",
            "Probably",
            "Unsure",
            "No"
          ],
          "help": ""
        }
      ]
    },
    {
      "id": "B",
      "title": "Current energy supply",
      "instrument": "household",
      "questions": [
        {
          "id": "B1",
          "label": "What does your household use for lighting and power now? (select all)",
          "type": "multi",
          "options": [
            "Grid / distribution utility",
            "Existing mini-grid or diesel plant",
            "Solar home system / solar lamps",
            "Own diesel or gasoline generator",
            "Shared or neighbour’s connection",
            "Batteries / charging service",
            "Kerosene, candles or firewood",
            "None"
          ],
          "help": ""
        },
        {
          "id": "B2",
          "label": "On average, how many hours a day do you have electricity?",
          "type": "select",
          "options": [
            "None",
            "Under 4 hours",
            "4–7 hours",
            "8–12 hours",
            "13–23 hours",
            "24 hours"
          ],
          "help": ""
        },
        {
          "id": "B3",
          "label": "At what times is electricity available? (select all)",
          "type": "multi",
          "options": [
            "Early morning (4–6 AM)",
            "Morning (6 AM–12 NN)",
            "Afternoon (12 NN–6 PM)",
            "Evening (6–10 PM)",
            "Late night (10 PM–4 AM)"
          ],
          "help": ""
        },
        {
          "id": "B4",
          "label": "How long have you had this supply arrangement?",
          "type": "select",
          "options": [
            "Under 1 year",
            "1–3 years",
            "4–10 years",
            "More than 10 years"
          ],
          "help": ""
        },
        {
          "id": "B5",
          "label": "In the last 30 days, how many unplanned power interruptions did you experience, and how long did the longest last? Interruptions: ____ ; longest: ____ hours",
          "type": "fields",
          "options": [],
          "help": "Leave unknown values blank. Zero means none.",
          "fields": [
            {
              "id": "interruptions",
              "label": "Interruptions in last 30 days",
              "type": "number"
            },
            {
              "id": "longest",
              "label": "Longest interruption (hours)",
              "type": "number"
            }
          ]
        },
        {
          "id": "B6",
          "label": "What was the effect of the last long interruption? (select all)",
          "type": "multi",
          "options": [
            "Spoiled food or stock",
            "Lost income",
            "Children could not study",
            "Medical or safety problem",
            "Could not charge phones / communicate",
            "Little effect"
          ],
          "help": ""
        },
        {
          "id": "B7",
          "label": "How much does your household spend in a typical month on each? (₱, write 0 if none)",
          "type": "fields",
          "options": [],
          "help": "Leave unknown values blank. Zero means none.",
          "fields": [
            {
              "id": "bills",
              "label": "Electricity bills (₱/month)",
              "type": "number"
            },
            {
              "id": "fuel",
              "label": "Generator diesel/gasoline (₱/month)",
              "type": "number"
            },
            {
              "id": "kerosene",
              "label": "Kerosene/candles (₱/month)",
              "type": "number"
            },
            {
              "id": "battery",
              "label": "Battery charging (₱/month)",
              "type": "number"
            },
            {
              "id": "cooking",
              "label": "LPG/firewood (₱/month)",
              "type": "number"
            }
          ]
        },
        {
          "id": "B8",
          "label": "How satisfied are you with your present supply?",
          "type": "select",
          "options": [
            "Very satisfied",
            "Satisfied",
            "Neutral",
            "Dissatisfied",
            "Very dissatisfied"
          ],
          "help": ""
        },
        {
          "id": "B9",
          "label": "What is the biggest problem with your present supply?",
          "type": "text",
          "options": [],
          "help": ""
        }
      ]
    },
    {
      "id": "C",
      "title": "Appliances & demand",
      "instrument": "household",
      "questions": [
        {
          "id": "C_loads",
          "label": "Appliance inventory — current use and plans",
          "type": "table",
          "rows": [
            "Lights (LED / CFL / other)",
            "Phone charger",
            "Television",
            "Electric fan",
            "Refrigerator / freezer",
            "Rice cooker / electric stove",
            "Washing machine",
            "Water pump",
            "Radio / sound system",
            "Computer / laptop / router",
            "Air conditioner",
            "Electric vehicle / e-bike charging",
            "Other"
          ],
          "columns": [
            {
              "id": "qty",
              "label": "Now (qty)",
              "type": "number"
            },
            {
              "id": "watts",
              "label": "Watts",
              "type": "number"
            },
            {
              "id": "hours",
              "label": "Hours/day",
              "type": "number"
            },
            {
              "id": "time",
              "label": "Time (M/A/E/N)",
              "type": "text"
            },
            {
              "id": "planned",
              "label": "Planned in 3 yrs (qty)",
              "type": "number"
            },
            {
              "id": "notes",
              "label": "Item / notes",
              "type": "text"
            }
          ]
        },
        {
          "id": "C1",
          "label": "Which appliance would you buy first if reliable electricity were available all day?",
          "type": "text",
          "options": [],
          "help": "Record the first appliance the household would buy."
        },
        {
          "id": "C2",
          "label": "Do you cook with electricity or plan to?",
          "type": "select",
          "options": [
            "Yes, now",
            "Yes, if supply and price allow",
            "No"
          ],
          "help": ""
        },
        {
          "id": "C3",
          "label": "Does anyone in the household depend on electrical medical equipment or refrigerated medicine?",
          "type": "select",
          "options": [
            "Yes",
            "No",
            "RTA"
          ],
          "help": "Priority-load indicator only; do not record the condition."
        }
      ]
    },
    {
      "id": "D",
      "title": "Productive & commercial use",
      "instrument": "household",
      "questions": [
        {
          "id": "D1",
          "label": "Does anyone in the household run a business or income activity that uses, or could use, electricity?",
          "type": "select",
          "options": [
            "Yes",
            "No (skip to Part E)"
          ],
          "help": "If No, skip the rest of Part D."
        },
        {
          "id": "D2",
          "label": "Type of activity (select all)",
          "type": "multi",
          "options": [
            "Sari-sari store",
            "Food processing / eatery",
            "Ice or cold storage",
            "Fish or crop processing",
            "Rice, corn or coconut mill",
            "Welding / carpentry / repair",
            "Sewing / weaving",
            "Water refilling / irrigation pump",
            "Internet / charging / laundry service",
            "Tourism accommodation",
            "Other:"
          ],
          "help": "Select all that apply. Record equipment in the table below.",
          "details": true
        },
        {
          "id": "D_equipment",
          "label": "Business equipment",
          "type": "table",
          "rows": [
            "Equipment 1",
            "Equipment 2",
            "Equipment 3"
          ],
          "columns": [
            {
              "id": "name",
              "label": "Equipment",
              "type": "text"
            },
            {
              "id": "qty",
              "label": "Qty",
              "type": "number"
            },
            {
              "id": "power",
              "label": "Watts / hp (specify unit)",
              "type": "text"
            },
            {
              "id": "hours",
              "label": "Hours/day",
              "type": "number"
            },
            {
              "id": "months",
              "label": "Peak months",
              "type": "text"
            },
            {
              "id": "fuel",
              "label": "Fuel (L/month)",
              "type": "number"
            }
          ]
        },
        {
          "id": "D3",
          "label": "If electricity were reliable, would you expand or start an activity?",
          "type": "select",
          "options": [
            "Yes: what and when?",
            "No",
            "Unsure"
          ],
          "help": "",
          "details": true
        },
        {
          "id": "D4",
          "label": "Is your business seasonal?",
          "type": "select",
          "options": [
            "Year-round",
            "Seasonal: peak months"
          ],
          "help": "",
          "details": true
        }
      ]
    },
    {
      "id": "E",
      "title": "Reliability & resilience",
      "instrument": "household",
      "questions": [
        {
          "id": "E1",
          "label": "What is the minimum daily supply that would meet your needs?",
          "type": "select",
          "options": [
            "8 hours",
            "12 hours",
            "18 hours",
            "24 hours"
          ],
          "help": ""
        },
        {
          "id": "E2",
          "label": "How long an interruption could your household tolerate before it causes serious trouble?",
          "type": "select",
          "options": [
            "Under 1 hour",
            "1–4 hours",
            "4–12 hours",
            "More than 12 hours"
          ],
          "help": ""
        },
        {
          "id": "E3",
          "label": "During typhoons or floods, what would you want the system to do?",
          "type": "select",
          "options": [
            "Keep only essential facilities powered",
            "Keep the whole community powered if possible",
            "Shut down safely and restore quickly",
            "DK"
          ],
          "help": ""
        },
        {
          "id": "E4",
          "label": "Which hazards have damaged homes or utilities here in the last 10 years? (select all possible answers)",
          "type": "multi",
          "options": [
            "Typhoon / strong wind",
            "Flood",
            "Storm surge",
            "Landslide",
            "Fire",
            "Earthquake",
            "Drought",
            "None"
          ],
          "help": ""
        },
        {
          "id": "E5",
          "label": "Would you accept short planned shutdowns for maintenance if given advance notice?",
          "type": "select",
          "options": [
            "Yes",
            "Yes, if under 4 hours",
            "No"
          ],
          "help": ""
        }
      ]
    },
    {
      "id": "F",
      "title": "Affordability & payment",
      "instrument": "household",
      "questions": [
        {
          "id": "F1",
          "label": "Would your household connect to a new 24-hour community microgrid if it were offered?",
          "type": "select",
          "options": [
            "Yes",
            "Yes, depending on price",
            "Not sure",
            "No: reason"
          ],
          "help": "",
          "details": true
        },
        {
          "id": "F2",
          "label": "Considering everything you now spend on energy (B7), what is the most your household could pay per month for reliable electricity?",
          "type": "select",
          "options": [
            "Below ₱300",
            "₱300–₱599",
            "₱600–₱999",
            "₱1,000–₱1,499",
            "₱1,500–₱1,999",
            "₱2,000 and above",
            "DK"
          ],
          "help": ""
        },
        {
          "id": "F3",
          "label": "Which arrangement would you prefer for paying for electricity?",
          "type": "select",
          "options": [
            "Prepaid load by mobile wallet or agent",
            "Prepaid at a local store",
            "Monthly bill",
            "Payment after harvest / catch season",
            "Pay per use with a small fixed fee"
          ],
          "help": ""
        },
        {
          "id": "F4",
          "label": "How would you prefer to cover a one-time connection cost (wiring, meter, service drop)?",
          "type": "select",
          "options": [
            "Pay upfront if less than ₱",
            "Instalments added to the bill",
            "Work contribution to the project",
            "Would need it fully subsidised",
            "DK"
          ],
          "help": "",
          "details": true
        },
        {
          "id": "F5",
          "label": "Is anyone in the household unable to pay the current cost of energy without cutting back on food or other needs?",
          "type": "select",
          "options": [
            "Often",
            "Sometimes",
            "Rarely",
            "Never",
            "RTA"
          ],
          "help": ""
        },
        {
          "id": "F6",
          "label": "Do you know of any subsidy or lifeline rate for low-income electricity users?",
          "type": "select",
          "options": [
            "Yes:",
            "No"
          ],
          "help": "",
          "details": true
        },
        {
          "id": "F7",
          "label": "How much would you need to save per month, compared with what you spend now, to switch to a microgrid?",
          "type": "select",
          "options": [
            "Any saving",
            "10–19%",
            "20–39%",
            "40% or more",
            "I would pay more for better service"
          ],
          "help": ""
        }
      ]
    },
    {
      "id": "G",
      "title": "Metering & service",
      "instrument": "household",
      "questions": [
        {
          "id": "G1",
