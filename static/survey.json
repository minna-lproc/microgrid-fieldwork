    {
      "id": "I",
      "title": "Community profile & growth",
      "instrument": "community",
      "questions": [
        {
          "id": "I_profile",
          "label": "Community baseline",
          "type": "fields",
          "fields": [
            {
              "id": "0",
              "label": "Name and position of informant",
              "type": "text"
            },
            {
              "id": "1",
              "label": "Total households / population (latest count)",
              "type": "text"
            },
            {
              "id": "2",
